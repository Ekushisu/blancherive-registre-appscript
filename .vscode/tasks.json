{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧩 Build UI",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔎 Vérifier le diff",
      "type": "shell",
      "command": "git",
      "args": ["diff", "--check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "📋 Statut Apps Script",
      "type": "shell",
      "command": "npm",
      "args": ["run", "status"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🚀 Build + push Apps Script",
      "type": "shell",
      "command": "npm",
      "args": ["run", "push"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "📦 Déployer une nouvelle version Web App",
      "type": "shell",
      "command": "npm",
      "args": ["run", "deploy:webapp"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["🚀 Build + push Apps Script"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    }
  ]
}
